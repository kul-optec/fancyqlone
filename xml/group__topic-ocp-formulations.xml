        <definition>void fancyqlone::reference_to_gradient</definition>
        <argsstring>(const LinearOCPStorage &amp;ocp, std::span&lt; const real_t &gt; ref, std::span&lt; real_t &gt; qr)</argsstring>
        <name>reference_to_gradient</name>
