function(qpoases_set_mkl_interface)
    set(MKL_INTERFACE_int "lp64")
    set(MKL_INTERFACE_long "ilp64")
    set(MKL_INTERFACE_long-long "ilp64")
    string(REPLACE " " "-" INDEX_TYPE "${QPOASES_BLAS_INDEX_TYPE}")
    if(NOT DEFINED MKL_INTERFACE_${INDEX_TYPE})
        message(SEND_ERROR "Unsupported index type ${QPOASES_BLAS_INDEX_TYPE}")
    endif()
    set(MKL_INTERFACE "${MKL_INTERFACE_${INDEX_TYPE}}" PARENT_SCOPE)
endfunction()

if(QPOASES_WITH_MKL AND QPOASES_WITH_OPENBLAS)
    message(WARNING "Options QPOASES_WITH_MKL and QPOASES_WITH_OPENBLAS are both enabled. Using MKL and ignoring OpenBLAS.")
endif()

target_compile_definitions(qpOASES_e PUBLIC EXTERNAL_BLAS
    "QPOASES_BLAS_INDEX_TYPE=${QPOASES_BLAS_INDEX_TYPE}")
message(STATUS "EXTERNAL_BLAS (${QPOASES_BLAS_INDEX_TYPE})")

# MKL
if(QPOASES_WITH_MKL)
    if(NOT DEFINED MKL_THREADING)
        set(MKL_THREADING "sequential")
    endif()
    if(NOT DEFINED MKL_LINK)
        set(MKL_LINK "static")
    endif()
    if(NOT DEFINED MKL_INTERFACE)
        qpoases_set_mkl_interface()
    endif()
    if(NOT "${QPOASES_MKLROOT}" STREQUAL "" AND NOT DEFINED ENV{MKLROOT})
        set(ENV{MKLROOT} "${QPOASES_MKLROOT}")
    endif()
    if(DEFINED ENV{MKLROOT})
        list(PREPEND CMAKE_FIND_ROOT_PATH "$ENV{MKLROOT}")
    endif()
    find_package(MKL REQUIRED)
    target_link_libraries(qpOASES_e PRIVATE MKL::MKL)
# OpenBLAS
elseif(QPOASES_WITH_OPENBLAS)
    find_package(OpenBLAS REQUIRED)
    target_link_libraries(qpOASES_e PRIVATE OpenBLAS::OpenBLAS)
# Generic BLAS/LAPACK
else()
    find_package(BLAS REQUIRED)
    find_package(LAPACK REQUIRED)
    target_link_libraries(qpOASES_e PRIVATE BLAS::BLAS LAPACK::LAPACK)
endif()
