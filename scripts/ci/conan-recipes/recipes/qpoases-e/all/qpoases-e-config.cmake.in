@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@QPOASES_WITH_BLAS@)
    if(@QPOASES_WITH_MKL@)
        if(NOT DEFINED MKL_THREADING)
            set(MKL_THREADING sequential)
        endif()
        if(NOT DEFINED MKL_LINK)
            set(MKL_LINK static)
        endif()
        if(NOT DEFINED MKL_INTERFACE)
            if("@QPOASES_BLAS_INDEX_TYPE@" STREQUAL "int")
                set(MKL_INTERFACE lp64)
            else()
                set(MKL_INTERFACE ilp64)
            endif()
        endif()
        if(DEFINED ENV{MKLROOT})
            list(PREPEND CMAKE_FIND_ROOT_PATH "$ENV{MKLROOT}")
        endif()
        find_dependency(MKL)
    elseif(@QPOASES_WITH_OPENBLAS@)
        find_dependency(OpenBLAS)
    else()
        find_dependency(BLAS)
        find_dependency(LAPACK)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/qpoases-e-targets.cmake")
check_required_components(qpoases-e)
